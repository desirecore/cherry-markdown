{
  "name": "@cherry-markdown/client",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "npx node ./scripts/sync-version.js && vite",
    "build": "npx node ./scripts/sync-version.js && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "version:sync": "node ./scripts/sync-version.js",
    "lint": "cd ../.. && npx prettier --check packages/client/src/**/*.{ts,vue} && npx eslint packages/client/src/**/*.{ts,vue}",
    "lint:fix": "cd ../.. && npx prettier --write packages/client/src/**/*.{ts,vue} && npx eslint packages/client/src/**/*.{ts,vue} --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@desirecore/super-doc": "*",
    "echarts": "^6.1.0",
    "katex": "^0.16.47",
    "pinyin": "^4.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.5"
  }
}
