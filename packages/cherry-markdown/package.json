{
  "name": "@desirecore/super-doc",
  "license": "Apache-2.0",
  "version": "0.2.15",
  "type": "module",
  "description": "A powerful Markdown editor with WYSIWYG support, based on cherry-markdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desirecore/super-doc.git",
    "directory": "packages/cherry-markdown"
  },
  "main": "./dist/super-doc.js",
  "module": "./dist/super-doc.esm.js",
  "style": "./dist/super-doc.min.css",
  "types": "./dist/types/index.d.ts",
  "directories": {
    "example": "examples"
  },
  "files": [
    "dist",
    "types",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/*.css"
  ],
  "scripts": {
    "iconfont": "gulp",
    "dev:vite": "vite",
    "build": "run-s clean build:all verify:dist",
    "build:all": "run-s iconfont build:styles build:types build:addons build:full build:core build:engine build:engine-full build:stream build:wysiwyg",
    "build:full": "cross-env TRANSPILE_ALL_DEPENDENCIES=true NODE_ENV=production rollup --config build/build.js",
    "build:core": "cross-env CORE_BUILD=true NODE_ENV=production rollup --config build/rollup.core.config.js",
    "build:engine": "cross-env CORE_BUILD=true NODE_ENV=production rollup --config build/rollup.engine.config.js",
    "build:engine-full": "cross-env CORE_BUILD=false NODE_ENV=production rollup --config build/rollup.engine.config.js",
    "build:stream": "cross-env NODE_ENV=production rollup --config build/rollup.stream.config.js",
    "build:wysiwyg": "cross-env NODE_ENV=production rollup --config build/rollup.wysiwyg.config.js",
    "build:addons": "node build/addons.build.js",
    "build:types": "tsc --project tsconfig.json && node build/replacePaths.js",
    "build:styles": "cross-env NODE_ENV=production rollup --config build/rollup.styles.config.js",
    "clean": "rimraf ./dist",
    "verify:dist": "node build/verify-dist.js",
    "check-bundle": "es-check es5 dist/super-doc.js",
    "test": "vitest",
    "test:update": "vitest -u",
    "test:types:engine-core": "node test/types/verify-engine-core-consumer.mjs",
    "lint": "cd ../.. && npx prettier --check packages/cherry-markdown/src/**/*.js && npx eslint --ignore-path .eslintignore packages/cherry-markdown/src/**/*.js",
    "lint:fix": "cd ../.. && npx prettier --write packages/cherry-markdown/src/**/*.js && npx eslint --ignore-path .eslintignore packages/cherry-markdown/src/**/*.js --fix",
    "examples": "serve -p 3000 ."
  },
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "super-doc"
  ],
  "author": "desirecore",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.27.1",
    "@babel/runtime": "^7.29.7",
    "@babel/runtime-corejs3": "^7.29.7",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-eslint": "^8.0.5",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-replace": "6.0.2",
    "@rollup/plugin-terser": "^0.4.3",
    "@types/echarts": "4.9.22",
    "@types/glob": "^7.2.0",
    "@types/jsdom": "^16.2.15",
    "@types/lodash": "^4.17.24",
    "@types/mermaid": "^8.2.9",
    "@types/virtual-dom": "^2.1.0",
    "@vitest/coverage-v8": "3.2.6",
    "async": "^3.2.6",
    "babel-plugin-prismjs": "^2.1.0",
    "cm-search-replace": "^1.0.1",
    "codemirror": "5.65.21",
    "core-js-pure": "^3.49.0",
    "cross-env": "^7.0.2",
    "dom-parser": "^0.1.6",
    "es-check": "^7.2.1",
    "glob": "^8.1.0",
    "gulp": "^5.0.1",
    "gulp-consolidate": "^0.2.0",
    "gulp-iconfont": "^11.0.0",
    "gulp-rename": "^2.0.0",
    "html2canvas": "^1.4.1",
    "juice": "^8.1.0",
    "lodash": "^4.18.1",
    "mitt": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "openai": "^5.23.2",
    "postcss": "^8.5.26",
    "prismjs": "^1.30.0",
    "replace-in-file": "^7.2.0",
    "rimraf": "^3.0.2",
    "rollup": "4.62.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass": "^1.101.0",
    "serve": "^14.2.6",
    "standard-version": "^9.5.0",
    "typescript": "4.7.2",
    "virtual-dom": "^2.1.1",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/kit": "^7.21.2",
    "@types/codemirror": "^5.60.17",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.13",
    "htmlparser2": "^12.0.0",
    "jsdom": "^29.1.1",
    "ws": "^8.21.0"
  },
  "resolutions": {
    "glob-parent": "5.1.2",
    "set-value": "4.0.1",
    "lodash.template": "4.5.0",
    "yargs-parser": "20.2.9",
    "xmldom": "0.5.0",
    "ansi-regex": "5.0.1",
    "glob-watcher": "6.0.0",
    "dompurify": "3.4.13"
  },
  "optionalDependencies": {
    "mermaid": "11.16.1"
  }
}
