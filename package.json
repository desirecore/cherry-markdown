{
  "name": "@desirecore/super-doc-workspaces",
  "description": "SuperDoc monorepo workspaces",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desirecore/super-doc.git"
  },
  "author": "desirecore",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "yarn workspace @desirecore/super-doc run iconfont",
    "prepare": "husky",
    "changeset": "npx @changesets/cli",
    "changeset-version": "npx @changesets/cli version",
    "dev": "yarn workspace @desirecore/super-doc dev:vite",
    "build": "yarn workspace @desirecore/super-doc build",
    "postbuild": "tsx scripts/post-build.ts",
    "dev:client": "yarn workspace @cherry-markdown/client tauri dev",
    "build:client": "yarn workspace @cherry-markdown/client tauri build",
    "build:vscodePlugin": "yarn workspace cherry-markdown-vscode-plugin build",
    "example:react": "yarn workspace @cherry-markdown/react_demo dev",
    "test": "yarn workspace @desirecore/super-doc test",
    "test:update": "yarn workspace @desirecore/super-doc test:update",
    "lint:all": "yarn workspace @desirecore/super-doc lint && yarn workspace @cherry-markdown/client lint && yarn workspace cherry-markdown-vscode-plugin lint",
    "lint:fix:all": "yarn workspace @desirecore/super-doc lint:fix && yarn workspace @cherry-markdown/client lint:fix && yarn workspace cherry-markdown-vscode-plugin lint:fix",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@changesets/cli": "^2.31.0",
    "@cherry-markdown/changesets-changelog-github": "^0.0.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@types/node": "^20.19.43",
    "commitlint": "^19.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-tencent": "^1.1.3",
    "eslint-plugin-file-progress": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "~9.1.7",
    "lint-staged": "~12.5.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.4.1"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.ts": "eslint --fix",
    "*.{js,ts,json,md}": "prettier --write"
  },
  "engines": {
    "node": ">=18",
    "yarn": ">=1.22.18"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
